#!/bin/bash

echo "=============================="
echo "Disabling tmpfs /tmp"
echo "=============================="

# Debian 13 (trixie) mounts /tmp as a tmpfs sized at half of RAM by
# default. Our instances are generally RAM constrained and their disks
# are NVMe backed, so a disk-backed /tmp is a much better trade-off.
# Masking the unit keeps /tmp on the root filesystem.
systemctl mask tmp.mount

echo "=============================="
echo "Disabled tmpfs /tmp"
echo "=============================="
